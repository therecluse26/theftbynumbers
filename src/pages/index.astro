---
import Basket from '../components/Basket.astro';
import Controls from '../components/Controls.astro';
import Hero from '../components/Hero.astro';
import Invest from '../components/Invest.astro';
import Ledger from '../components/Ledger.astro';
import Notes from '../components/Notes.astro';
import Rail from '../components/Rail.astro';
import Receipt from '../components/Receipt.astro';
import Ribbon from '../components/Ribbon.astro';
import Roads from '../components/Roads.astro';
import Stack from '../components/Stack.astro';
import Base from '../layouts/Base.astro';
import {
  basketHtml,
  dialSvg,
  heroText,
  investText,
  ledgerHtml,
  lifeCost,
  outlaysDonut,
  receiptHtml,
  receiptLede,
  ribbon,
  roadsHtml,
  roadsLede,
  stack,
} from '../lib/render';
import { computeBreakdown, defaultInputs } from '../lib/tax';

// The opening state is rendered here, at build time, from the same functions
// the browser script uses. The page is readable before any script runs.
const inputs = defaultInputs();
const breakdown = computeBreakdown(inputs);
const hero = heroText(breakdown, inputs);
const invest = investText(breakdown, inputs);
---

<Base
  title="Theft by Numbers - What your taxes cost, and what they could have been"
  description="A calculator that shows what one year of US tax costs you, what it would have bought, and what it would be worth if you had invested it instead."
>
  <Rail />
  <Hero hero={hero} dial={dialSvg(breakdown.effectiveRate)} />
  <Ribbon ribbon={ribbon(breakdown)} hero={hero} />

  <div class="wrap">
    <Controls inputs={inputs} />

    <div class="empty" id="empty" hidden>
      <p>Enter an income above to see the breakdown.</p>
    </div>

    <main class="results" id="results">
      <Ledger rows={ledgerHtml(breakdown, inputs)} />
      <Basket cards={basketHtml(breakdown.total)} />
      <Receipt
        life={lifeCost(breakdown, inputs)}
        donut={outlaysDonut(breakdown, inputs)}
        lede={receiptLede(breakdown, inputs)}
        groups={receiptHtml(breakdown, inputs)}
      />
      <Invest invest={invest} years={inputs.years} />
      <Stack stack={stack(invest.balanceValue, inputs, breakdown.kept)} />
      <Roads lede={roadsLede()} groups={roadsHtml(breakdown, inputs)} />
      <Notes />
    </main>
  </div>

  <script>
    import '../scripts/app';
  </script>
</Base>
