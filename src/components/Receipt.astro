---
import type { DonutRender, LifeCost } from '../lib/render';

interface Props {
  life: LifeCost;
  donut: DonutRender;
  lede: string;
  groups: string;
}

const { life, donut, lede, groups } = Astro.props;
---

<section class="section">
  <div class="section-head">
    <p class="eyebrow">Section three</p>
    <h2>What your money was actually spent on</h2>
  </div>

  <div class="life">
    <p class="eyebrow eyebrow-y">Your life's work, in their hands</p>
    <p class="life-fig num" id="lifeFig">{life.figure}</p>
    <p class="life-note" id="lifeNote">{life.note}</p>
    <div id="lifeWeek" set:html={life.weekHtml} />
    <p class="hint" id="lifeWeekNote">{life.weekNote}</p>
  </div>

  <div class="donut" id="donutHost">
    <div class="dn-chart">
      <svg
        id="donutSvg"
        viewBox="-80 -80 160 160"
        preserveAspectRatio="xMidYMid meet"
        role="img"
        aria-label="Federal spending split by category, with your own share of each"
        set:html={donut.svg}
      />
    </div>
    <div class="dn-legend">
      <div class="dn-row dn-head">
        <i class="dn-dot dn-dot-blank"></i>
        <span class="dn-name">Where it went</span>
        <span class="dn-pct">Share</span>
        <span class="dn-yours">Yours</span>
        <span class="dn-life">Your life</span>
      </div>
      <div id="donutLegend" set:html={donut.legend} />
    </div>
    <!-- The connector between a lit row and its slice. Decorative; the legend
         carries the same pairing in text. -->
    <svg id="donutLink" class="dn-link" aria-hidden="true" focusable="false"></svg>
  </div>
  <p class="hint" id="donutNote" style="max-width:70ch">{donut.note}</p>

  <p class="rc-intro" id="receiptLede">{lede}</p>
  <div id="receiptGroups" set:html={groups} />
</section>
