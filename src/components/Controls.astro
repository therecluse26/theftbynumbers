---
import { ASSUMPTIONS, STATES, TAX } from '../lib/data';
import { commas } from '../lib/format';
import {
  childrenHint,
  earnersHint,
  employerHint,
  propertyTaxHint,
  salesTaxHint,
  statusEcho,
  tenureHint,
} from '../lib/render';
import type { Inputs } from '../lib/types';

interface Props {
  inputs: Inputs;
}

const { inputs } = Astro.props;
const { income, investment, horizon, stateRateSlider, dependents } = ASSUMPTIONS;
---

<section class="controls" aria-label="Your details">
  <div class="controls-head">
    <p class="eyebrow eyebrow-y">Your details</p>
    <p class="eyebrow" id="statusEcho">{statusEcho(inputs)}</p>
  </div>

  <div class="controls-grid">
    <div class="field">
      <label for="income">Gross annual income</label>
      <div class="money-input">
        <span>$</span>
        <input
          type="text"
          id="income"
          inputmode="numeric"
          autocomplete="off"
          value={commas(income.defaultIncome)}
          data-max={income.maxIncome}
          aria-describedby="incomeHint"
        />
      </div>
      <p class="hint" id="incomeHint">Wages before anything is taken out.</p>
    </div>

    <div class="field">
      <p class="field-label" id="statusLabel">Filing status</p>
      <!--
        The id is load-bearing. app.ts finds these buttons by it. A second
        .seg group on the page would otherwise silently join the same query
        and clear the pressed filing status on every click.
      -->
      <div class="seg" id="statusSeg" role="group" aria-labelledby="statusLabel">
        {
          TAX.filingStatuses.map((status) => (
            <button
              type="button"
              data-status={status.id}
              aria-pressed={status.id === inputs.status}
            >
              {status.shortName}
            </button>
          ))
        }
      </div>
      <p class="hint">Sets your brackets and standard deduction.</p>
    </div>

    <!--
      Only a joint return can cover two earners, so this field is hidden for
      the other two statuses. app.ts shows and hides it from syncLabels().
    -->
    <div class="field" id="earnersField" hidden={inputs.status !== 'mfj'}>
      <p class="field-label" id="earnersLabel">Who earned it</p>
      <div class="seg" id="earnersSeg" role="group" aria-labelledby="earnersLabel">
        <button type="button" data-earners="1" aria-pressed={inputs.earners === 1}>
          One earner
        </button>
        <button type="button" data-earners="2" aria-pressed={inputs.earners === 2}>
          Two earners
        </button>
      </div>
      <p class="hint" id="earnersHint">{earnersHint(inputs)}</p>
    </div>

    <div class="field">
      <label for="children">Children who qualify for the child tax credit</label>
      <select id="children">
        {
          Array.from({ length: dependents.maxChildren + 1 }, (_, n) => (
            <option value={n} selected={n === inputs.children}>
              {n}
            </option>
          ))
        }
      </select>
      <p class="hint" id="childrenHint" set:html={childrenHint(inputs)} />
    </div>

    <div class="field">
      <p class="field-label" id="tenureLabel">Your housing</p>
      <div class="seg" id="tenureSeg" role="group" aria-labelledby="tenureLabel">
        <button type="button" data-tenure="own" aria-pressed={inputs.tenure === 'own'}>
          Own
        </button>
        <button type="button" data-tenure="rent" aria-pressed={inputs.tenure === 'rent'}>
          Rent
        </button>
      </div>
      <p class="hint" id="tenureHint">{tenureHint(inputs)}</p>
    </div>

    <div class="field">
      <label for="state">State</label>
      <select id="state">
        {
          STATES.map((state, index) => (
            <option value={index} selected={index === inputs.stateIndex}>
              {state.selectLabel ?? state.name}
            </option>
          ))
        }
      </select>
      <p class="hint">Sets the state tax rate and the home price used below.</p>
    </div>

    <div class="field">
      <div class="slider-row">
        <label for="stateRate" style="margin:0">State income tax rate</label>
        <span class="slider-val num" id="stateRateVal">
          {inputs.stateRatePct.toFixed(1)}%
        </span>
      </div>
      <input
        type="range"
        id="stateRate"
        min={stateRateSlider.minPct}
        max={stateRateSlider.maxPct}
        step={stateRateSlider.stepPct}
        value={inputs.stateRatePct}
      />
      <p class="hint">A flat approximation, not a bracket calculation.</p>
    </div>

    <div class="field">
      <div class="slider-row">
        <label for="years" style="margin:0">Years at this income</label>
        <span class="slider-val num" id="yearsVal">{inputs.years}</span>
      </div>
      <input
        type="range"
        id="years"
        min={horizon.minYears}
        max={horizon.maxYears}
        step="1"
        value={inputs.years}
      />
      <p class="hint">How long to run the comparison.</p>
    </div>

    <div class="field">
      <div class="slider-row">
        <label for="rate" style="margin:0">Annual investment return</label>
        <span class="slider-val num" id="rateVal">
          {inputs.returnPct.toFixed(1)}%
        </span>
      </div>
      <input
        type="range"
        id="rate"
        min={investment.minAnnualReturnPct}
        max={investment.maxAnnualReturnPct}
        step={investment.stepAnnualReturnPct}
        value={inputs.returnPct}
      />
      <p class="hint">
        {investment.defaultAnnualReturnPct}% is roughly the long-run US market
        average after inflation.{' '}
        <a
          href={ASSUMPTIONS.meta.fields['investment.defaultAnnualReturnPct'].url}
          target="_blank"
          rel="noopener noreferrer"
        >
          {ASSUMPTIONS.meta.fields['investment.defaultAnnualReturnPct'].label}
        </a>
      </p>
    </div>

    <div class="field field-full">
      <p class="field-label">Also count</p>
      <div class="checks">
        <label class="check">
          <input type="checkbox" id="employer" checked={inputs.countEmployerShare} />
          <span class="check-body">
            <strong>The employer's half of payroll tax</strong>
            <span set:html={employerHint()} />
          </span>
        </label>
        <label class="check">
          <input type="checkbox" id="sales" checked={inputs.countSalesTax} />
          <span class="check-body">
            <strong>Estimated sales tax</strong>
            <span id="salesHint" set:html={salesTaxHint(inputs)} />
          </span>
        </label>
        <label class="check">
          <input type="checkbox" id="property" checked={inputs.countPropertyTax} />
          <span class="check-body">
            <strong>Property tax</strong>
            <span id="propertyHint" set:html={propertyTaxHint(inputs)} />
          </span>
        </label>
      </div>
    </div>
  </div>
</section>
