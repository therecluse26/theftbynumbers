---
import { stackFootnote } from '../lib/render';
import type { StackRender } from '../lib/render';

interface Props {
  stack: StackRender;
}

const { stack } = Astro.props;
---

<section class="section">
  <div class="section-head">
    <p class="eyebrow">Section four</p>
    <h2>What the balance unlocks</h2>
  </div>
  <p class="stack-lede" id="stackLede">{stack.lede}</p>
  <div class="stack" id="stack" set:html={stack.html} />
  <p class="hint" style="margin-top:14px;max-width:62ch">{stackFootnote()}</p>
</section>
