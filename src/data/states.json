  "meta": {
    "updatedAt": "2026-08-26",
    "fields": {
      "incomeTaxRatePct": {
        "updateMode": "manual",
        "label": "Tax Foundation, state individual income tax rates",
        "url": "https://taxfoundation.org/data/all/state/state-income-tax-rates/",
        "maxAgeDays": 400,
        "updatedAt": "2026-08-26",
        "note": "A flat approximation. Graduated states use the top rate a typical wage earner reaches, not the top bracket. The source publishes no national figure, so the US row carries the median of the fifty-one published rates, the same rule the property tax rate uses. The mean is 3.84%, but nine states levy no income tax at all, so the mean reads low for the forty-two that do."
      },
      "propertyTaxRatePct": {
        "updateMode": "manual",
        "label": "Tax Foundation, property taxes paid as a share of home value",
        "url": "https://taxfoundation.org/data/all/state/property-taxes-by-state-county/",
        "maxAgeDays": 400,
        "updatedAt": "2026-08-26",
        "note": "Table 2 of the source, the 2024 effective rate column. The source publishes no national figure, so the US row carries the median of the fifty-one published rates. That median under-weights the populous high-rate states, so the national default is the mild end of the range."
      },
      "salesTaxRatePct": {
        "updateMode": "manual",
        "label": "Tax Foundation, state and local sales tax rates, midyear 2026",
        "url": "https://taxfoundation.org/data/all/state/2026-sales-tax-rates-midyear/",
        "maxAgeDays": 400,
        "updatedAt": "2026-08-27",
        "note": "The state rate plus the average local rate, the source's combined column, as of 1 July 2026. Unlike the income and property columns, this source does publish a national figure, so the US row carries its population-weighted average of 7.53% rather than a median of the fifty-one. A typical reader is a person, not a state. Alaska levies no state sales tax but its boroughs do, so it is 1.82%; only Delaware, Montana, New Hampshire and Oregon are zero. New Jersey's average local rate is slightly negative because Salem County charges a reduced rate."
      },
      "medianHomeValue": {
        "updateMode": "fetch",
        "updater": "zillow-zhvi",
        "label": "Zillow Home Value Index, all homes, smoothed and seasonally adjusted",
        "url": "https://www.zillow.com/research/data/",
        "maxAgeDays": 45,
        "updatedAt": "2026-08-26"
      }
    }
  },
