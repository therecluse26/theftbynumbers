{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The give",
  "description": "Section six: what the same money does when you hand it over yourself. Cheapest first is not required; the site sorts.",
  "type": "object",
  "required": ["meta", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": { "$ref": "meta.schema.json" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "singular", "plural", "price", "note", "source"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "singular": { "type": "string", "minLength": 1 },
          "plural": { "type": "string", "minLength": 1 },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Dollars for one of them. A cost-per-life figure is an estimate with a wide band. Say so in the note."
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "description": "Shown under the label. Supports the {price} token."
          },
          "source": {
            "type": "object",
            "required": ["label", "url"],
            "additionalProperties": false,
            "description": "Required here, not optional. A number about saving a life must name who worked it out.",
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    }
  }
}
