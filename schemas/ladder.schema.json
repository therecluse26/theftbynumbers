{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The ladder",
  "description": "Section five: what the invested balance buys back. An item has a fixed price or a priceFrom block, never both.",
  "type": "object",
  "required": ["meta", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": { "$ref": "meta.schema.json" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "singular", "plural", "note"],
        "additionalProperties": false,
        "oneOf": [{ "required": ["price"] }, { "required": ["priceFrom"] }],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "singular": { "type": "string", "minLength": 1 },
          "plural": { "type": "string", "minLength": 1 },
          "singularInState": {
            "type": "string",
            "minLength": 1,
            "description": "Used when a real state is picked. Supports the {state} token."
          },
          "pluralInState": { "type": "string", "minLength": 1 },
          "price": { "type": "number", "exclusiveMinimum": 0 },
          "priceFrom": {
            "type": "object",
            "required": ["ref", "multiplier"],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "enum": [
                  "metals.gold.usdPerTroyOz",
                  "state.medianHomeValue",
                  "basket.college-year",
                  "charity.life-amf",
                  "reader.annualTakeHome",
                  "reader.monthlyTakeHome"
                ],
                "description": "Where the price comes from. A reader.* ref prices the rung from the reader's own take-home. Add a case to src/lib/ladder.ts before adding a value here."
              },
              "multiplier": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "description": "Shown under the label. Supports the {price} token."
          }
        }
      }
    }
  }
}
