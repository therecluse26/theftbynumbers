{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Federal tax data",
  "type": "object",
  "required": [
    "meta",
    "taxYear",
    "filingStatuses",
    "brackets",
    "standardDeduction",
    "credits",
    "capitalGains",
    "payroll"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "meta": { "$ref": "meta.schema.json" },
    "taxYear": { "type": "integer", "minimum": 2000, "maximum": 2100 },
    "filingStatuses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "shortName", "who", "whoObject"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/statusId" },
          "name": { "type": "string", "minLength": 1 },
          "shortName": { "type": "string", "minLength": 1 },
          "who": { "type": "string", "minLength": 1 },
          "whoObject": { "type": "string", "minLength": 1 }
        }
      }
    },
    "brackets": {
      "type": "object",
      "required": ["single", "mfj", "hoh"],
      "additionalProperties": false,
      "properties": {
        "single": { "$ref": "#/definitions/bracketTable" },
        "mfj": { "$ref": "#/definitions/bracketTable" },
        "hoh": { "$ref": "#/definitions/bracketTable" }
      }
    },
    "standardDeduction": { "$ref": "#/definitions/byStatus" },
    "credits": {
      "type": "object",
      "required": ["childTaxCredit"],
      "additionalProperties": false,
      "description": "Only the child tax credit is modelled. The earned income tax credit is not: it needs a phase-in, a plateau, a phase-out and an investment-income test per child count and per status, and being subtly wrong about a refund is worse than being silent about one.",
      "properties": {
        "childTaxCredit": {
          "type": "object",
          "required": ["perChild", "phaseOutStart", "phaseOutStep", "phaseOutPerStep"],
          "additionalProperties": false,
          "properties": {
            "perChild": { "type": "number", "minimum": 0 },
            "phaseOutStart": { "$ref": "#/definitions/byStatus" },
            "phaseOutStep": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "The statute reduces the credit for each $1,000 or fraction thereof over the threshold, so this is data, not arithmetic."
            },
            "phaseOutPerStep": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "capitalGains": {
      "type": "object",
      "required": [
        "longTerm",
        "netInvestmentIncomeRate",
        "netInvestmentIncomeThreshold"
      ],
      "additionalProperties": false,
      "description": "Used only to state what the invested pot would owe. No figure on this page is reduced by it: which account the money sits in is the reader's choice, not a tax rate.",
      "properties": {
        "longTerm": {
          "type": "object",
          "required": ["single", "mfj", "hoh"],
          "additionalProperties": false,
          "properties": {
            "single": { "$ref": "#/definitions/bracketTable" },
            "mfj": { "$ref": "#/definitions/bracketTable" },
            "hoh": { "$ref": "#/definitions/bracketTable" }
          }
        },
        "netInvestmentIncomeRate": { "$ref": "#/definitions/rate" },
        "netInvestmentIncomeThreshold": {
          "$ref": "#/definitions/byStatus",
          "description": "Statutory and never indexed. Frozen at these figures since 2013."
        }
      }
    },
    "payroll": {
      "type": "object",
      "required": ["socialSecurity", "medicare"],
      "additionalProperties": false,
      "properties": {
        "socialSecurity": {
          "type": "object",
          "required": ["rate", "wageBase"],
          "additionalProperties": false,
          "properties": {
            "rate": { "$ref": "#/definitions/rate" },
            "wageBase": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "medicare": {
          "type": "object",
          "required": ["rate", "additionalRate", "additionalThreshold"],
          "additionalProperties": false,
          "properties": {
            "rate": { "$ref": "#/definitions/rate" },
            "additionalRate": { "$ref": "#/definitions/rate" },
            "additionalThreshold": { "$ref": "#/definitions/byStatus" }
          }
        }
      }
    }
  },
  "definitions": {
    "statusId": { "enum": ["single", "mfj", "hoh"] },
    "rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "byStatus": {
      "type": "object",
      "required": ["single", "mfj", "hoh"],
      "additionalProperties": false,
      "properties": {
        "single": { "type": "number", "minimum": 0 },
        "mfj": { "type": "number", "minimum": 0 },
        "hoh": { "type": "number", "minimum": 0 }
      }
    },
    "bracketTable": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered lowest to highest. The first entry must start at 0.",
      "items": {
        "type": "object",
        "required": ["from", "rate"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "number", "minimum": 0 },
          "rate": { "$ref": "#/definitions/rate" }
        }
      }
    }
  }
}
