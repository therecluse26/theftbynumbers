{
  "name": "endthetheft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "npm run data:validate && npm run check:tax && npm run check:types",
    "check:tax": "node --import ./scripts/lib/ts-register.mjs scripts/check-tax.mjs",
    "check:types": "astro check",
    "data:validate": "node scripts/validate-data.mjs",
    "data:check": "node scripts/update-data.mjs --check",
    "data:update": "node scripts/update-data.mjs",
    "data:update:dry": "node scripts/update-data.mjs --dry-run",
    "data:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "astro": "^7.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^6.0.3"
  }
}
